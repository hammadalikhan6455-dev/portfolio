# ─── Server ────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── Database ──────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/hammad-portfolio
TEST_MONGODB_URI=mongodb://localhost:27017/hammad-portfolio-test

# ─── JWT ───────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_here
JWT_REFRESH_SECRET=your_super_secret_refresh_key_here

# ─── Client ────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ─── Cloudinary (media uploads) ────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── SMTP (lead email notifications) ──────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
NOTIFY_EMAIL=hammadalikhan6455@gmail.com

# ─── Admin seed (run: node src/scripts/seed.js) ────────────
ADMIN_EMAIL=admin@hammad.dev
ADMIN_PASSWORD=Admin@1234!

# ─── Logging ───────────────────────────────────────────────
LOG_LEVEL=info
